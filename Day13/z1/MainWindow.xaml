<Window x:Class="CRMBusiness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRM - Система управления клиентами" 
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        MinWidth="800">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddClientCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditClientCommand}"/>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DeleteClientCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteClientCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="ExitMenuItem_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="Клиенты">
                <MenuItem Header="Добавить клиента" Command="{Binding AddClientCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Редактировать клиента" Command="{Binding EditClientCommand}" InputGestureText="Ctrl+E"/>
                <Separator/>
                <MenuItem Header="Удалить клиента" Command="{Binding DeleteClientCommand}" InputGestureText="Ctrl+D / Del"/>
            </MenuItem>
            <MenuItem Header="Настройки">
                <MenuItem Header="О программе" Click="AboutMenuItem_Click" InputGestureText="F1"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Добавить" 
                    Command="{Binding AddClientCommand}"
                    ToolTip="Добавить клиента (Ctrl+N)"
                    Background="#4CAF50"
                    Foreground="White"
                    Width="90" Height="30"
                    Margin="2"/>
            <Button Content="Редактировать" 
                    Command="{Binding EditClientCommand}"
                    ToolTip="Редактировать клиента (Ctrl+E)"
                    Background="#2196F3"
                    Foreground="White"
                    Width="90" Height="30"
                    Margin="2"/>
            <Button Content="Удалить" 
                    Command="{Binding DeleteClientCommand}"
                    ToolTip="Удалить клиента (Ctrl+D или Del)"
                    Background="#F44336"
                    Foreground="White"
                    Width="90" Height="30"
                    Margin="2"/>
        </ToolBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Список клиентов" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ListView x:Name="ClientsListView" 
                          Grid.Row="1"
                          SelectedItem="{Binding SelectedClient}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                            <GridViewColumn Header="ФИО" Width="180" DisplayMemberBinding="{Binding FullName}"/>
                            <GridViewColumn Header="Телефон" Width="120" DisplayMemberBinding="{Binding Phone}"/>
                            <GridViewColumn Header="Email" Width="150" DisplayMemberBinding="{Binding Email}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <Border Grid.Column="1" 
                    Margin="10" 
                    Background="#F0F0F0" 
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Данные клиента" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="ФИО:" Grid.Row="1" FontWeight="Bold" Margin="5,5,5,0"/>
                    <TextBlock x:Name="DisplayFullName" Grid.Row="2" Margin="5" TextWrapping="Wrap"/>

                    <TextBlock Text="Телефон:" Grid.Row="3" FontWeight="Bold" Margin="5,5,5,0"/>
                    <TextBlock x:Name="DisplayPhone" Grid.Row="4" Margin="5" TextWrapping="Wrap"/>

                    <TextBlock Text="Email:" Grid.Row="5" FontWeight="Bold" Margin="5,5,5,0"/>
                    <TextBlock x:Name="DisplayEmail" Grid.Row="6" Margin="5" TextWrapping="Wrap"/>

                    <TextBlock Text="История взаимодействий:" Grid.Row="7" FontWeight="Bold" Margin="5,5,5,0"/>
                    <TextBlock x:Name="DisplayHistory" Grid.Row="8" 
                               Margin="5"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>