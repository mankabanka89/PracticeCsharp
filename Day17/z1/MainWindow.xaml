<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRM - Управление клиентами" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- плавное появление окна -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <!-- выезд вкладки -->
        <Storyboard x:Key="TabSlideInAnimation">
            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                From="200,0,0,0" To="0,0,0,0"
                                Duration="0:0:0.3"
                                DecelerationRatio="0.8"/>
        </Storyboard>

        <!-- изменение цвета при наведении -->
        <Storyboard x:Key="CardHoverEnterAnimation">
            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                            To="#FFE8F0FE" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="CardHoverLeaveAnimation">
            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                            To="#FFFFFFFF" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- разворачивания карточки  -->
        <Storyboard x:Key="ExpandCardAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                             From="80" To="180" Duration="0:0:0.3"
                             DecelerationRatio="0.7"/>
        </Storyboard>

        <Storyboard x:Key="CollapseCardAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Height"
                             From="180" To="80" Duration="0:0:0.3"
                             DecelerationRatio="0.7"/>
        </Storyboard>

        <Style x:Key="ClientCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid" Loaded="MainGrid_Loaded">

        <Border Background="#FF2C3E50" Height="60" VerticalAlignment="Top">
            <TextBlock Text="CRM - Управление клиентами" 
                       FontSize="22" FontWeight="Bold" 
                       Foreground="White"
                       VerticalAlignment="Center" Margin="20,0,0,0"/>
        </Border>

        <StackPanel Margin="20,80,20,20" VerticalAlignment="Top">

            <TextBlock Text="Список клиентов" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button x:Name="TabAll" Content="Все клиенты" 
                        Width="120" Height="35" Margin="0,0,10,0"
                        Background="#FF3498DB" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="TabAll_Click"/>
                <Button x:Name="TabActive" Content="Активные" 
                        Width="120" Height="35" Margin="0,0,10,0"
                        Background="#FF95A5A6" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="TabActive_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel x:Name="CardsContainer" Margin="0,0,0,20"/>
            </ScrollViewer>

            <Button x:Name="AddButton" Content="+ Добавить клиента"
                    Width="150" Height="35" Margin="0,10,0,0"
                    Background="#FF2ECC71" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="AddButton_Click"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>